<script>
    jQuery("#sizeSelectionSidebarOverlay").click(function(){
        jQuery('#sizeSelectionSidebarOverlay').hide();
        jQuery('#sizeSelectionSidebar').hide();
        jQuery("html, body").css("overflow", "");
    });
    jQuery("#selectSizeButton").click(function(){
        document.body.scrollTop = 0;
        document.documentElement.scrollTop = 0;
        jQuery('#sizeSelectionSidebar').show();
        jQuery('#sizeSelectionSidebarOverlay').show();
        jQuery("html, body").css("overflow", "hidden");
    });
    jQuery(document).ready(function(){
        jQuery("#selectSizeButton").after(``);
    });

    function loadLogic(sku) {
        jQuery('#loadingOverlay').show();

        // Redirect to the new URL with /product/ before the SKU
        var newUrl = 'https://furnishmyplaceflooring.com/product/' + sku;
        window.location.replace(newUrl);
    }
</script>

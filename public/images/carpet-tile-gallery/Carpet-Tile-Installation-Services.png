</div>

<style>
.fmp-tagline-badge{
  display:inline-flex;
  align-items:center;
  gap:9px;
  margin-top:6px;
  margin-bottom:6px;
  padding:7px 16px;
  font-family:inherit;
  font-size:14px;
  font-weight:600;
  letter-spacing:.4px;
  color:#ffffff;
  background:rgba(255,255,255,.10);
  border:1px solid rgba(45,212,191,.55); /* teal accent, matches site */
  border-radius:999px;
  backdrop-filter:blur(4px);
}
.fmp-tagline-badge .fmp-dot{
  width:7px;height:7px;border-radius:50%;
  background:#2dd4bf; /* teal dot */
  box-shadow:0 0 8px rgba(45,212,191,.9);
}
@media(max-width:600px){
  .fmp-tagline-badge{font-size:12.5px;padding:6px 13px;}
}
</style>



<style id="wp-custom-css">

.product-image {
    position: relative;
    height: 350px !important;
    overflow: hidden;
    background: var(--gray-100);
}
@media (max-width: 480px) {
    .product-image {
        height: 350px !important;
    }
}

.woocommerce-privacy-policy-text {
    display: none;
}


input#quantity_66e530d1935d9 {
    display: none;
}
.woocommerce .button.alt {
    background-color: #009688;
    color: #fff;
    padding: 15px 30px;
    border-radius: 5px;
    font-size: 16px;
    text-transform: uppercase;
    border: none;
    transition: background-color 0.3s ease;
    height: 50px;
    align-content: center;
}



/* Default styles for desktop */
.price {
    font-size: 30px;
}

.old-price {
    font-weight: bold;
    text-decoration: line-through;
    color: #fdbe3b;
    font-weight: 700;
}

.new-price {
    font-size: 48px;
    color: #27bbad;
    font-weight: 800;
}

/* Mobile version styles (screen width less than 768px) */
@media (max-width: 768px) {
    .price {
        font-size: 20px;
    }

    .old-price {
        font-weight: bold;
        text-decoration: line-through;
        color: #fdbe3b;
        font-weight: 700;
        font-size: 18px;
    }

    .new-price {
        font-size: 25px;
        color: #27bbad;
        font-weight: 800;
    }
}




.rum_sst_contents {
    position: fixed;
    margin: 0;

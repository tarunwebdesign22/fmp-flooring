#sizeSelectionSidebarOverlay{
	position: fixed;
	top: 0;
	bottom: 0;
	left: 0;
	right: 0;
	background: rgba(40,40,40,0.5);
	z-index: 99999;
}
#sizeSelectionSidebar{
	position: absolute;
	right: 0px;
	top: 0px;
	width: 100%;
	max-width: 400px;
	min-height: 100%;
	height: 100%;
	background: white;
	z-index: 999999999999;
	padding: 20px 10px;
	overflow-y: scroll;
}
.oneSizeOption{
	display: block;
	border: 1px solid #ecdbc3;
	background-color: #f9f7ea;
	margin-bottom: 15px;
	padding: 15px;
	color: #000;
	cursor: pointer;
	width: 100%;
	height: 100px;
}
.oneSizeOption > div{
	display: flex;
	justify-content: space-between;
	align-items: center;
	height: 100%;
}
.oneSizeOption.selected{
	background-color: lavenderblush;
	border: 2px solid #ef979f;
}
.oneSizeOption:hover{
	background-color: lavenderblush;
	border: 2px solid #ef979f;
	margin-bottom: 13px;
}
.oneSizeOption span{
	padding: 0px 5px;
}
.sizeDiscount{
	color: #e5554e;
	font-weight: bolder;
}
.backButton:hover{
	text-decoration: underline;
	font-weight: normal;
}
.selectSizeTitle{
	font-size: 25px;
	color: #e5554e;
	font-weight: bold;
}
.mobile-nav.nav-left{
	justify-content: left !important;
}
#selectSizeButton{
	width: 100%;
	max-width: 450px;
	margin: 30px 0px;
}
#selectSizeButton p, #colorOptions > p{
	font-size: 110%;
	font-weight: bold;
	margin-bottom: 5px;
}
#selectSizeList{
	display: flex;
	background: white;
	justify-content: space-between;
	padding: 10px 15px;
	border: 1px solid grey;
	border-radius: 10px;
	max-width: 400px;
	width: 100%;
}
#selectedSize{
	font-size: 110%;
}
#selectSizeIcon{
	display: flex;
	font-size: 90%;
	align-items: center;
}
#selectSizeIcon i{
	margin-left: 10px;
	font-size: 150%;
}
#selectSizeList:hover{
	border: 2px solid #2ABDAF;
	margin-bottom: -2px;
	padding: 10px 15px;
	width: 100%;
	max-width: 450px !important;
}
#loadingOverlay{
	position: fixed;
	top: 0;
	bottom: 0;
	left: 0;
	right: 0;
	background: rgba(40,40,40,0.9);
	z-index: 99999;
}
#loadingOverlay p{
	display: flex;
  align-items: center;
  height: 100vh;
  width: 100vw;
  text-align: center;
  color: white;
  justify-content: center;
  font-size: 250%;
}
.shippingInfo span{
	border: 1px solid;
	width: auto !important;
	padding: 2px 15px !important;
	font-size: 90%;
	margin-top: 10px;
	margin-right: 5px;
	border-radius: 20px;
	background: #8c933f;
	color: white;
}
.shippingInfo{
	display: flex !important;
	justify-content: flex-end !important;
}
.available_size_options{
	margin-bottom: 20px;
}
.available_size_options p{
	font-size: 120%;
	font-weight: bold;
}
.product-small.box img{
	width: auto !important;
	height: auto !important;
	max-height: 300px !important
}
.product-small.box .box-image div{
	text-align: center !important;
}
.variations_price_range{
	font-size: 110% !important;
	font-weight: bold;
	margin-top: -20px;
	margin-bottom: 10px;
}
.variations_price_range a{
	color: #e5554e; !important;
}
.variations_price_range a:hover{
	color: #f2241d; !important;
}
#colorOptions{
	margin: 0px 0px;
}
#colorOptions a img{
	width: 50px !important;
}
#colorOptions a{
	display: inline-block; !important;
	margin: 5px;
	padding: 5px 2px;
}
#colorOptions a:hover{
	display: inline-block; !important;
	border: 2px solid #3C7D84;
	margin: 5px;
	padding: 3px 0px;
}
#colorOptions a.selected{
	display: inline-block; !important;
	border: 2px solid grey;
	margin: 5px;
	padding: 3px 0px;
}

.product-infographic{
	display: none !important;
}
.wvg-single-gallery-image-container img{
	min-height: 600px !important;
	max-height: 600px !important;
	width: auto !important;
}


.tried h2{
	font-weight: bold !important;
	color: black !important;
}



/* General Styling */
.woocommerce-checkout-payment {
    background-color: #f8f9fa;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.woocommerce-checkout-payment ul.payment_methods {
    list-style: none;
    padding-left: 0;
}

.woocommerce-checkout-payment li.wc_payment_method {
    padding: 15px;
    margin-bottom: 30px; /* Increased gap between payment methods */
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 5px;
    transition: background 0.3s ease, border-color 0.3s ease;
}

.woocommerce-checkout-payment li.wc_payment_method:hover {
    background-color: #f1f1f1;
    border-color: #009688;
}

.woocommerce-checkout-payment li.wc_payment_method input[type="radio"] {
    margin-right: 10px;
}

.woocommerce-checkout-payment li.wc_payment_method label {
    font-weight: 600;
    font-size: 16px;
    color: #333;
    cursor: pointer;
}

.woocommerce-checkout-payment li.wc_payment_method img {
    margin-left: 10px;
    vertical-align: middle;
    height: 25px;
}

/* Payment Box Styling */
.payment_box {
    padding: 15px;
    background-color: #f9f9f9;
    border-radius: 5px;
    border: 1px solid #eee;
    margin-top: 10px;
    font-size: 14px;
    color: #555;
}

/* Credit Card Form Styling */
.wc-stripe-upe-form {
    margin-top: 10px;
}

.wc-stripe-upe-element iframe {
    border-radius: 5px;
    border: none !important; /* Removed the inner border */
}

/* Place Order Button Styling */
.woocommerce .button.alt {
    background-color: #009688;
    color: #fff;
    padding: 15px 30px;
    border-radius: 5px;
    font-size: 16px;
    text-transform: uppercase;
    border: none;
    transition: background-color 0.3s ease;
}

.woocommerce .button.alt:hover {
    background-color: #00796b;
}

/* Terms and Conditions Styling */
.woocommerce-terms-and-conditions-wrapper {
    margin-top: 20px;
    font-size: 13px;
    color: #666;
}

.woocommerce-terms-and-conditions-wrapper a {
    color: #009688;
    text-decoration: underline;
}

.woocommerce-terms-and-conditions-wrapper a:hover {
    text-decoration: none;
}


fieldset#wc-stripe-upe-form {
    border: none;
}














.StripeElement {
    background-color: #fff;
 
    padding: 0px 5px 5px 5px;
    border-radius: 10px;
    transition: border-color 0.3s ease-in-out;
    width: 100%;
}





#card-element {
    width: 100%;
    margin-bottom: 15px;
}

#expiration-date-element, #cvc-element {
    display: block;
    margin-bottom: 15px;
}

.StripeElement--focus {
    border-color: #4a90e2;
}

.StripeElement--invalid {
    border-color: #fa755a;
}

.StripeElement--webkit-autofill {
    background-color: #fefde5 !important;
}

#card-errors {
    color: #fa755a;
    margin-top: 10px;
}
































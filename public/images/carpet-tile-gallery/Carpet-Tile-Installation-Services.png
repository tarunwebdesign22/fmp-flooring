					<div class="e-con-inner">
				<div class="elementor-element elementor-element-135ee8c elementor-widget elementor-widget-html" data-id="135ee8c" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<!-- In Stock Specials Button – Place below Explore Projects buttons -->
<style>
  .fire-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 14px;
    margin-top: 25px;
    width: 100%;
  }
  .fire-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(46, 196, 182, 0.12);
    border: 1px solid rgba(46, 196, 182, 0.4);
    color: #159c8f;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 20px;
    animation: fireBounce 2s ease-in-out infinite;
  }
  .fire-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 19px 52px;
    font-family: 'Poppins', sans-serif;
    font-size: 17px;
    font-weight: 800;
    color: #ffffff !important;
    background: linear-gradient(135deg, #F44336, #e53935);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 8px 26px rgba(244, 67, 54, 0.42);
    animation: fireFloat 3s ease-in-out infinite, firePulse 2.4s ease-in-out infinite;
    transition: transform 0.3s ease;
  }
  .fire-btn:hover {
    color: #ffffff !important;
    transform: translateY(-4px) scale(1.04);
    animation-play-state: paused;
    box-shadow: 0 14px 40px rgba(244, 67, 54, 0.6);
  }
  .fire-btn:active { transform: translateY(-1px) scale(1); }
  .fire-btn svg {
    position: relative;
    z-index: 2;
    transition: transform 0.3s ease;
  }
  .fire-btn:hover svg { transform: translateX(6px); }
  .fire-btn-text { position: relative; z-index: 2; }
  .fire-shine {
    position: absolute;
    top: 0;
    left: -120%;
    width: 70%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.45), transparent);
    transform: skewX(-20deg);
    z-index: 1;
    animation: fireShine 3.2s ease-in-out infinite;
  }
  @keyframes fireBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  @keyframes fireFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  @keyframes firePulse {
    0%, 100% { box-shadow: 0 8px 26px rgba(244, 67, 54, 0.42); }
    50% { box-shadow: 0 8px 34px rgba(244, 67, 54, 0.72); }
  }
  @keyframes fireShine {
    0% { left: -120%; }
    55%, 100% { left: 130%; }
  }
</style>
